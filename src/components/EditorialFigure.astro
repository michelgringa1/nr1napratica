---
import fs from 'node:fs';
import path from 'node:path';
import sharp from 'sharp';

/**
 * Figura editorial de página nova (17/11/2026; bloco "imagem + texto ao lado" desde 17/11/2026, pedido do Michel).
 * Só renderiza a imagem se o arquivo existir em public/images/editorial/ NA HORA DO BUILD. Sem o arquivo, não sai nada da figura no HTML
 * (nem <figure> vazia, nem comentário), o build não falha nem avisa e o TEXTO DO SLOT CONTINUA NA PÁGINA, como parágrafos comuns: a página nasce
 * sem a figura e passa a ter a figura no build seguinte ao dia em que o arquivo for salvo no lugar (imagem nova = nome de arquivo novo,
 * porque o .htaccess dá cache imutável de 1 ano). width/height saem do arquivo real (sem layout shift).
 *
 *   file     nome do .webp em public/images/editorial/
 *   alt      texto alternativo
 *   caption  legenda visível (opcional; nas fotos realistas geradas por IA: "Imagem ilustrativa")
 *   formato  '16x9' = largura da coluna do texto (classe global .editorial-img); se vier slot, o texto sai DEPOIS da figura
 *            '1x1'  = BLOCO de duas colunas: figura de uns 300 px (clamp 260 a 320) + o conteúdo do <slot/> ao lado, alinhado ao centro
 *                     na vertical. Até 720 px empilha (figura primeiro, centrada, no máximo 340 px, texto embaixo). Um 1x1 SEM slot
 *                     sai sozinho, centralizado, no máximo 440 px (formato antigo).
 *   lado     só para 1x1: em que lado fica o TEXTO. 'direita' (padrão) = figura à esquerda e texto à direita; 'esquerda' = texto à
 *            esquerda e figura à direita. No HTML a figura vem sempre primeiro (leitor de tela e celular). Convenção: alternar
 *            (primeira 1x1 da página com 'direita', a segunda com 'esquerda').
 *   alinhar  só para 1x1: 'centro' (padrão) centraliza figura e texto na vertical, bom quando o texto é do tamanho da figura ou menor;
 *            'topo' alinha a figura ao topo do texto, para texto bem mais alto que a figura (ex.: bloco do CFP em /consultoria-de-nr1/).
 *
 * O texto do slot é conteúdo da página (h2, p, ol herdam os estilos globais); só o primeiro filho perde a margem de cima e o último a de baixo.
 */
export interface Props {
  file: string;
  alt: string;
  caption?: string;
  formato: '16x9' | '1x1';
  lado?: 'direita' | 'esquerda';
  alinhar?: 'centro' | 'topo';
}
const { file, alt, caption, formato, lado = 'direita', alinhar = 'centro' } = Astro.props;

// Só nome simples de .webp (sem barra nem ..): o arquivo é sempre procurado só em public/images/editorial/.
const nomeValido = /^[a-z0-9][a-z0-9._-]*\.webp$/i.test(file);
const caminho = path.join(process.cwd(), 'public', 'images', 'editorial', file);
const existe = nomeValido && fs.existsSync(caminho);

let largura = 0;
let altura = 0;
if (existe) {
  const meta = await sharp(caminho).metadata();
  largura = meta.width ?? 0;
  altura = meta.height ?? 0;
}
const pronto = existe && largura > 0 && altura > 0;
const temTexto = Astro.slots.has('default');
const bloco = pronto && formato === '1x1' && temTexto;
---
{bloco ? (
  <div class:list={['bloco-fig', lado === 'esquerda' ? 'bloco-fig--esquerda' : 'bloco-fig--direita', alinhar === 'topo' && 'bloco-fig--topo']}>
    <figure class="figura figura--1x1">
      <img
        class="editorial-img"
        src={`/images/editorial/${file}`}
        alt={alt}
        width={largura}
        height={altura}
        loading="lazy"
        decoding="async"
      />
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
    <div class="bloco-fig__texto"><slot /></div>
  </div>
) : (
  <>
    {pronto && (
      <figure class:list={['figura', `figura--${formato}`]}>
        <img
          class="editorial-img"
          src={`/images/editorial/${file}`}
          alt={alt}
          width={largura}
          height={altura}
          loading="lazy"
          decoding="async"
        />
        {caption && <figcaption>{caption}</figcaption>}
      </figure>
    )}
    <slot />
  </>
)}

<style>
  /* Estilo só desta figura (não mexe no CSS global). A .editorial-img global traz borda, cantos arredondados, sombra e margem de
     1,6rem/2rem: a margem passa para a <figure> (ou para o bloco), para a legenda ficar colada na imagem. */
  .figura {
    margin: 1.6rem 0 2rem;
  }
  .figura img {
    margin: 0;
  }
  .figura figcaption {
    margin-top: 0.6rem;
    font-size: 0.86rem;
    line-height: 1.4;
    text-align: center;
    color: var(--cinza-700);
  }
  /* 1:1 sem texto ao lado (formato antigo): centralizada, no máximo 440 px de largura. */
  .figura--1x1 {
    max-width: 440px;
    margin-inline: auto;
  }

  /* ---------- Bloco 1:1 (figura + texto ao lado) ---------- */
  .bloco-fig {
    --col-fig: clamp(260px, 42%, 320px);
    display: grid;
    grid-template-columns: var(--col-fig) minmax(0, 1fr);
    column-gap: 1.75rem;
    row-gap: 1.2rem;
    align-items: center;
    margin: 2rem 0;
  }
  .bloco-fig .figura--1x1 {
    max-width: none;
    margin: 0;
    grid-column: 1;
    grid-row: 1;
  }
  .bloco-fig__texto {
    position: relative;
    min-width: 0;
    grid-column: 2;
    grid-row: 1;
    padding-left: 1.5rem;
  }
  /* Fio dourado (o mesmo gradiente do sublinhado dos H2) entre a figura e o texto. */
  .bloco-fig__texto::before {
    content: "";
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    left: 0;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--ouro), transparent);
  }
  /* O texto do slot vem da página (sem o atributo de escopo): :global. Sem margem estranha no primeiro e no último filho. */
  .bloco-fig__texto > :global(:first-child) {
    margin-top: 0;
  }
  .bloco-fig__texto > :global(:last-child) {
    margin-bottom: 0;
  }

  /* Texto bem mais alto que a figura: figura no topo (o padrão é centralizar). */
  .bloco-fig--topo {
    align-items: start;
  }

  /* Texto à esquerda, figura à direita (a figura segue primeiro no HTML). */
  .bloco-fig--esquerda {
    grid-template-columns: minmax(0, 1fr) var(--col-fig);
  }
  .bloco-fig--esquerda .figura--1x1 {
    grid-column: 2;
  }
  .bloco-fig--esquerda .bloco-fig__texto {
    grid-column: 1;
    padding-left: 0;
    padding-right: 1.5rem;
  }
  .bloco-fig--esquerda .bloco-fig__texto::before {
    left: auto;
    right: 0;
  }

  /* Até 720 px: empilha, figura primeiro e centrada (no máximo 340 px), texto embaixo, sem fio. */
  @media (max-width: 720px) {
    .bloco-fig,
    .bloco-fig--esquerda {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.5rem;
      margin: 1.6rem 0 2rem;
    }
    .bloco-fig .figura--1x1,
    .bloco-fig--esquerda .figura--1x1 {
      grid-column: 1;
      grid-row: 1;
      width: 100%;
      max-width: 340px;
      justify-self: center;
    }
    .bloco-fig__texto,
    .bloco-fig--esquerda .bloco-fig__texto {
      grid-column: 1;
      grid-row: 2;
      padding-left: 0;
      padding-right: 0;
    }
    .bloco-fig__texto::before {
      display: none;
    }
  }
</style>
