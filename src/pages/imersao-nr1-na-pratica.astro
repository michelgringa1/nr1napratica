---
import Base from '../layouts/Base.astro';
import TOC from '../components/TOC.astro';
import FAQ from '../components/FAQ.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, GO_IMERSAO } from '../data/site';
import {
  articleSchema,
  faqSchema,
  breadcrumbSchema,
  ENTITIES,
  type FaqItem,
} from '../data/schema';

/**
 * Página de oferta da Imersão NR1 na Prática, 5ª edição "A Virada" (05 e 06/12/2026).
 * Texto: rascunho aprovado (rascunhos/imersao-nr1-na-pratica.md), convertido por script em 17/11/2026, com 3 ajustes do Michel
 * (sem "horário de Brasília"; sem a data exata do fim da suspensão das multas; "Atualizado em" próprio da página).
 * Fatos: página oficial da imersão lida em 17/11/2026 (rascunhos/fonte-oficial-imersao-5a-edicao-2026-11-17.txt).
 * Valor e lote: "1º lote a R$ 39" é o do dia 17/11/2026 (último dia do 1º lote). Quando o lote mudar: trocar o selo, a resposta rápida,
 * a tabela de dados, a seção "Quanto custa", o FAQ, a faixa final, a nota do rodapé do texto e o `price` do Event, e subir DATA_PAGINA.
 * Os 7 botões levam a /go/imersao-nr1-na-pratica/?s=pgimersao<posicao> (o `s` é o `src` da Hotmart, sem hífen; o destino está em scripts/go-map.json).
 * Esta página NÃO leva o BannerImersao nem o CardLivro (ela já tem os botões da Imersão).
 */
const title = "Imersão NR1 na Prática 5ª Edição: Datas, Valor e Inscrição";
const description =
  "Imersão NR1 na Prática 5ª edição com Izabella Camargo: 05 e 06/12, ao vivo no YouTube, certificado e 1º lote a R$ 39 em 17/11/2026. Veja o programa.";
const path = '/imersao-nr1-na-pratica/';

// Data própria da página (não usa SITE.updatedLabel: o "Atualizado em" global é de Julho/2026 e vale para outras páginas).
const DATA_PAGINA = '17/11/2026';
const DATA_ISO = '2026-11-17';

// Imagem do topo (arte do Michel, 1400x732) e imagem de compartilhamento (1200x630). Nome novo = cache de 1 ano sem problema.
const imagemTopo = '/images/imersao-nr1-na-pratica-hero.webp';
const imagemTopoAlt =
  'Arte da Imersão NR1 na Prática, 5ª edição, com Izabella Camargo ao microfone: Comece 2027 como Gestor de NR1.';
const imagemOg = '/images/og-imersao-nr1-na-pratica.jpg';

// /go/ (D34): src novo para a Hotmart = pgimersao<posicao> (uma posição por botão; SEM hífen de propósito: os src que a Hotmart já
// recebia, bannerblg e rvwimsao, são só letras; a trava-go aceita a-z, 0-9, _ e -, até 40).
const go = (pos: string) => {
  const s = `pgimersao${pos}`;
  if (!/^[a-z0-9_-]{1,40}$/.test(s)) throw new Error(`/go/: posição inválida "${s}"`);
  return `${GO_IMERSAO}?s=${s}`;
};

const toc = [
  { id: "o-que-e", label: "O que é a Imersão NR1 na Prática 5ª edição?" },
  { id: "a-virada", label: "Por que a 5ª edição se chama \"A Virada\"?" },
  { id: "programa", label: "O que você aprende nos 2 dias da imersão?" },
  { id: "agenda", label: "Qual é a agenda de 5 e 6 de dezembro?" },
  { id: "valor", label: "Quanto custa a Imersão NR1 na Prática?" },
  { id: "izabella", label: "Quem é a Izabella Camargo, que conduz a imersão?" },
  { id: "caminhos", label: "Quais são os dois caminhos para 2027?" },
  { id: "formacao-especifica", label: "Precisa de formação específica para atuar com NR-1?" },
  { id: "para-quem", label: "Para quem é a Imersão NR1 na Prática?" },
  { id: "confiavel", label: "A Imersão NR1 na Prática é confiável?" },
  { id: "como-se-inscrever", label: "Como se inscrever na imersão, passo a passo?" },
  { id: "formacao-gestor", label: "E a Formação Gestor de NR1?" },
  { id: "faq", label: "Perguntas frequentes sobre a Imersão NR1 na Prática" },
  { id: "fontes", label: "Fontes" },
];

const faqItems: FaqItem[] = [
  {
    q: "Quando é a Imersão NR1 na Prática 5ª edição?",
    a: "<p>Nos dias <strong>05 e 06 de dezembro de 2026</strong>, sábado e domingo, das 9h às 17h, ao vivo no YouTube.</p>",
  },
  {
    q: "Qual é o horário da imersão?",
    a: "<p>Os dois dias começam às 9h, têm pausa para o almoço das 12h às 14h e terminam às 17h. Pode passar um pouco do horário se os participantes pedirem aprofundamento.</p>",
  },
  {
    q: "Onde assistir à imersão?",
    a: "<p>Ao vivo no YouTube, nos dois dias do evento. Como a transmissão é pelo YouTube, você assiste no computador, no tablet ou no celular.</p>",
  },
  {
    q: "Quanto custa a Imersão NR1 na Prática?",
    a: "<p>Em 17/11/2026, o 1º lote custava <strong>R$ 39</strong>, e era o último dia desse lote. O valor muda por lote: vale sempre o que a página oficial mostra no dia da compra.</p>",
  },
  {
    q: "A imersão vai ficar gravada?",
    a: "<p>O ingresso cobre o ao vivo. A gravação é adicional, comprada com o ingresso até 04/12 às 23h59, por R$ 199 ou 12x de R$ 19,98 (lido em 17/11/2026), com acesso vitalício.</p>",
  },
  {
    q: "A imersão tem certificado?",
    a: "<p>Sim. Todos os participantes presentes recebem um <strong>certificado digital de participação</strong> por e-mail, em até 7 dias depois do evento.</p>",
  },
  {
    q: "Preciso ser psicólogo para participar?",
    a: "<p>Não. Segundo o MTE, a NR-1 e a NR-17 não estabelecem, de forma geral, um profissional específico ou uma categoria exclusiva para avaliar os riscos psicossociais: a empresa escolhe quem tem conhecimento técnico adequado.</p>",
  },
  {
    q: "Para quem é a imersão?",
    a: "<p>Para quem quer aplicar a NR-1 na prática e começar 2027 em um de dois caminhos: consultor externo de empresas ou referência em NR-1 dentro da empresa onde já trabalha. Não há pré-requisito acadêmico.</p>",
  },
  {
    q: "Tem reembolso se eu me arrepender?",
    a: "<p>Sim. Você tem <strong>7 dias de direito de arrependimento</strong>, com 100% do valor de volta, sem explicar o motivo: no ingresso, a partir da compra; na gravação, a partir da liberação do acesso (CDC, art. 49).</p>",
  },
  {
    q: "Vale a pena para quem já estuda NR-1?",
    a: "<p>Vale, e a 5ª edição foi criada pensando nesse público. Muita coisa mudou em 2026: a vigência, a suspensão das multas pelo STF, a conciliação e novas interpretações. É o encontro para começar 2027 com tudo em dia.</p>",
  },
];

const urlPagina = new URL(path, SITE.url).href;
const urlOg = new URL(imagemOg, SITE.url).href;

const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  '@id': `${urlPagina}#evento`,
  name: 'Imersão NR1 na Prática · 5ª edição · A Virada',
  description:
    'A Imersão NR1 na Prática 5ª edição, "A Virada", acontece em 05 e 06 de dezembro de 2026, das 9h às 17h, ao vivo no YouTube, conduzida pela Izabella Camargo e professores. O ingresso inclui os 2 dias e certificado digital de participação, com direito de arrependimento de 7 dias.',
  startDate: '2026-12-05T09:00:00-03:00',
  endDate: '2026-12-06T17:00:00-03:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  inLanguage: SITE.lang,
  // Os dois URLs abaixo apontam para ESTA página (que leva aos botões /go/), não para a página oficial: um link direto sem o código
  // de afiliado, em dado estruturado, deixaria o Google mandar o clique para fora do /go/.
  location: { '@type': 'VirtualLocation', url: urlPagina },
  url: urlPagina,
  image: [urlOg],
  organizer: { '@type': 'Person', name: 'Izabella Camargo' },
  performer: { '@type': 'Person', name: 'Izabella Camargo' },
  // Sem aggregateRating e sem Review (decisão do projeto). Sem priceValidUntil: não há fonte para o fim do lote além de "hoje".
  offers: {
    '@type': 'Offer',
    price: '39.00',
    priceCurrency: 'BRL',
    availability: 'https://schema.org/InStock',
    validFrom: DATA_ISO,
    url: urlPagina,
  },
};

const schemas = [
  articleSchema({
    headline: "Imersão NR1 na Prática 5ª edição: datas, valor e como se inscrever",
    description,
    url: path,
    image: imagemOg,
    datePublished: DATA_ISO,
    dateModified: DATA_ISO,
    mentions: [ENTITIES.riscosPsicossociais, ENTITIES.gro, ENTITIES.izabella, ENTITIES.gestorNr1],
    keywords: [
      'imersão nr1 na prática',
      'imersão nr1 na prática 5ª edição',
      'imersão nr1 izabella camargo',
      'imersão nr1 valor',
      'imersão nr1 inscrição',
    ],
  }),
  eventSchema,
  faqSchema(faqItems),
  breadcrumbSchema([
    ['Início', '/'],
    ['Imersão NR1 na Prática', path],
  ]),
];
---
<Base title={title} description={description} schemas={schemas} ogType="article" ogImage={imagemOg}>
  <div class="page-hero page-hero--imersao">
    <div class="container">
      <p class="kicker">Evento ao vivo · 5ª edição · 05 e 06/12/2026</p>
      <h1>Imersão NR1 na Prática 5ª edição: datas, valor e como se inscrever</h1>
      <img
        class="hero-imersao-img"
        src={imagemTopo}
        alt={imagemTopoAlt}
        width="1400"
        height="732"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>

  <article class="container article">
    <Breadcrumbs crumbs={[['Início', '/'], ['Imersão NR1 na Prática', path]]} />
    <div class="article-meta">
      <span class="updated-badge">Atualizado em {DATA_PAGINA}</span>
      <span>Por <a href="/sobre/">{SITE.name}</a> · Conteúdo informativo, pode conter links de afiliado</span>
    </div>

    <p class="selo">1º lote a R$ 39 · hoje, 17/11/2026, é o último dia do 1º lote</p>

    <div class="fact-box" id="resposta-rapida">
      <p><strong>Resposta rápida:</strong> a Imersão NR1 na Prática 5ª edição, "A Virada", acontece em <strong>05 e 06 de dezembro de 2026</strong>, das 9h às 17h, <strong>ao vivo no YouTube</strong>, conduzida pela <strong>Izabella Camargo</strong> e professores. O ingresso inclui os 2 dias e certificado digital de participação. Em 17/11/2026, o 1º lote custava <strong>R$ 39</strong>, com direito de arrependimento de 7 dias.</p>
    </div>

    <div class="cta-wrap">
      <a class="btn-cta" href={go('hero')} target="_blank" rel="sponsored nofollow noopener">Quero minha virada em 2027</a>
    </div>

    <div class="fact-box" id="destaques">
      <h2 class="mt-0">Destaques</h2>
      <ul class="checks">
      <li>✔ 2 dias inteiros ao vivo com a Izabella Camargo e professores</li>
      <li>✔ Programa atualizado com tudo o que mudou na NR-1 em 2026</li>
      <li>✔ Exercício guiado: você sai com o seu plano para 2027 escrito</li>
      <li>✔ Certificado digital de participação, por e-mail, em até 7 dias</li>
      <li>✔ Sem pré-requisito acadêmico para participar</li>
      <li>✔ Direito de arrependimento de 7 dias, garantido pelo Código de Defesa do Consumidor</li>
      </ul>
    </div>

    <h2 id="dados">A imersão em dados</h2>
    <div class="table-wrap">
      <table>
      <thead>
      <tr>
      <th>Item</th>
      <th>Detalhe</th>
      </tr>
      </thead>
      <tbody>
      <tr>
      <td>Nome</td>
      <td>Imersão NR1 na Prática</td>
      </tr>
      <tr>
      <td>Edição</td>
      <td>5ª edição, "A Virada"</td>
      </tr>
      <tr>
      <td>Datas</td>
      <td>05 e 06 de dezembro de 2026 (sábado e domingo)</td>
      </tr>
      <tr>
      <td>Horário</td>
      <td>Das 9h às 17h, com pausa para o almoço das 12h às 14h</td>
      </tr>
      <tr>
      <td>Formato e onde assistir</td>
      <td>Online, ao vivo no YouTube</td>
      </tr>
      <tr>
      <td>Quem conduz</td>
      <td>Izabella Camargo e professores</td>
      </tr>
      <tr>
      <td>O ingresso inclui</td>
      <td>Os 2 dias ao vivo e o certificado digital de participação</td>
      </tr>
      <tr>
      <td>Valor do 1º lote</td>
      <td>R$ 39 (lido em 17/11/2026, último dia do 1º lote; o valor muda por lote e vale o da página oficial no dia da compra)</td>
      </tr>
      <tr>
      <td>Gravação</td>
      <td>Adicional opcional na compra: R$ 199 ou até 12x de R$ 19,98, só até 04/12 às 23h59, acesso vitalício</td>
      </tr>
      <tr>
      <td>Certificado</td>
      <td>Digital, de participação, enviado por e-mail em até 7 dias depois do evento</td>
      </tr>
      <tr>
      <td>Arrependimento</td>
      <td>7 dias, com 100% do valor de volta (CDC, art. 49)</td>
      </tr>
      <tr>
      <td>Fonte</td>
      <td>Página oficial da imersão, lida em 17/11/2026</td>
      </tr>
      </tbody>
      </table>
    </div>

    <div class="cta-wrap">
      <a class="btn-cta" href={go('fatos')} target="_blank" rel="sponsored nofollow noopener">Garantir meu ingresso</a>
    </div>

    <p>Quer contexto de mercado e a nossa opinião? Leia a <a href="/blog/imersao-nr1-na-pratica-izabella-camargo/">análise completa da Imersão NR1 na Prática</a>.</p>

    <TOC items={toc} />

    <h2 id="o-que-e">O que é a Imersão NR1 na Prática 5ª edição?</h2>

    <p>A Imersão NR1 na Prática é um evento online e ao vivo de dois dias, conduzido pela Izabella Camargo, para quem quer <strong>aplicar a NR-1 nas empresas</strong> com foco nos riscos psicossociais. A 5ª edição tem um nome que resume a proposta: <strong>"A Virada"</strong>. A ideia: pôr em dia o que mudou na norma e começar 2027 com um plano pronto.</p>

    <p>O contexto é concreto. Com a atualização da <a href="/nr-1-atualizada-2026/">NR-1</a>, em vigor desde maio de 2026, toda empresa com funcionários CLT passou a ter de identificar, registrar e gerenciar os riscos psicossociais. Muitas querem cumprir e ainda não sabem por onde começar. A imersão prepara você para ocupar esse espaço com método, e o segundo dia termina com um exercício guiado que vira o seu plano escrito para 2027.</p>

    <h2 id="a-virada">Por que a 5ª edição se chama "A Virada"?</h2>

    <p>Porque 2026 foi o ano em que a NR-1 mudou as regras do jogo, e 2027 é o ano de sair do improviso. Segundo a página oficial da imersão, a linha do tempo de 2026 foi esta:</p>

    <ol>
    <li><strong>Maio:</strong> a atualização da NR-1 entra em vigor (em vigor desde 26/05/2026).</li>
    <li><strong>Junho:</strong> o STF suspende as multas dos itens psicossociais.</li>
    <li><strong>Agosto:</strong> o plenário do STF confirma a suspensão.</li>
    <li><strong>Setembro:</strong> começa a conciliação e a suspensão é prorrogada.</li>
    <li><strong>Ao longo do ano:</strong> novas orientações e interpretações.</li>
    </ol>

    <p>A norma seguiu valendo: o que ficou suspenso, temporariamente, foram as multas dos itens psicossociais, enquanto governo e setores empresariais negociam. Essas multas seguem suspensas temporariamente pelo STF (a prorrogação por mais 90 dias foi decidida em setembro de 2026, na ADPF 1316), e a norma segue valendo. Detalhes no guia sobre a <a href="/multa-nr1-2026/">multa da NR-1 em 2026</a>.</p>

    <p>Por isso a organização reuniu quem quer atuar com NR-1 num encontro de atualização e preparação <strong>para 2027</strong>, para iniciantes e para quem já estuda a norma.</p>

    <h2 id="programa">O que você aprende nos 2 dias da imersão?</h2>

    <p>O programa da 5ª edição tem seis blocos: primeiro você entende o que mudou, depois aprende a aplicar e, no fim, a se apresentar para quem decide.</p>

    <ol>
    <li><strong>O que mudou na NR-1 em 2026 (e o que vale para 2027):</strong> vigência, suspensão das multas e conciliação; o que continua obrigatório; o que pode acontecer quando a suspensão acabar; os erros de interpretação mais comuns.</li>
    <li><strong>O Gerenciamento de Riscos Ocupacionais, sem complicação:</strong> o que a empresa precisa fazer, passo a passo e em linguagem simples. Para chegar com a base em dia, leia o nosso guia de <a href="/gro-e-pgr-o-que-e/">GRO e PGR</a>.</li>
    <li><strong>Saúde mental na gestão de riscos:</strong> como ela entra no gerenciamento de riscos e por que proteger as pessoas protege o negócio.</li>
    <li><strong>Cultura de prevenção e liderança:</strong> como fazer as pessoas falarem antes de adoecer e agir antes do afastamento.</li>
    <li><strong>Como ser contratado ou reconhecido como Gestor de NR1:</strong> para o consultor, cliente ideal, abordagem e proposta; na empresa, como levar a NR-1 à diretoria e propor o projeto ou o cargo.</li>
    <li><strong>Exercício guiado:</strong> você sai com o seu plano para 2027 escrito.</li>
    </ol>

    <p>O bloco 5 trata de como ser contratado ou reconhecido como Gestor de NR1: para o consultor, o cliente ideal, a abordagem e a proposta; para quem está na empresa, como levar a NR-1 à diretoria e propor o projeto ou o cargo. A página oficial resume a promessa do evento com a chamada "Comece 2027 como Gestor de NR1 e feche contratos de alto valor com empresas".</p>

    <div class="cta-wrap">
      <a class="btn-cta" href={go('programa')} target="_blank" rel="sponsored nofollow noopener">Quero minha virada em 2027</a>
    </div>

    <h2 id="agenda">Qual é a agenda de 5 e 6 de dezembro?</h2>

    <p>Os dois dias seguem a mesma agenda, sempre ao vivo no YouTube, das 9h às 17h:</p>

    <div class="table-wrap">
      <table>
      <thead>
      <tr>
      <th>Horário</th>
      <th>O que acontece</th>
      </tr>
      </thead>
      <tbody>
      <tr>
      <td>9h</td>
      <td>Início</td>
      </tr>
      <tr>
      <td>12h</td>
      <td>Pausa para o almoço</td>
      </tr>
      <tr>
      <td>14h</td>
      <td>Retorno</td>
      </tr>
      <tr>
      <td>17h</td>
      <td>Encerramento</td>
      </tr>
      </tbody>
      </table>
    </div>

    <p>A organização avisa que o encontro pode passar um pouco do horário se os participantes pedirem para aprofundar algum ponto, e garante que todo o conteúdo combinado é entregue dentro do horário programado.</p>

    <p>Dica para aproveitar: reserve o sábado e o domingo desde já e deixe um caderno ao lado da tela para o exercício guiado do segundo dia. Como a transmissão é pelo YouTube, você assiste no computador, no tablet ou no celular.</p>

    <h2 id="valor">Quanto custa a Imersão NR1 na Prática?</h2>

    <p>Em 17/11/2026, o <strong>1º lote custava R$ 39</strong>, no último dia desse lote. O valor muda por lote: vale o que a página oficial mostra no dia da compra, e quem entra cedo paga menos.</p>

    <p>O ingresso inclui:</p>

    <ul>
    <li>os <strong>2 dias inteiros ao vivo</strong> com a Izabella Camargo e professores;</li>
    <li>o <strong>certificado digital de participação</strong>, enviado por e-mail em até 7 dias depois do evento.</li>
    </ul>

    <p>Na compra, você pode acrescentar a <strong>gravação</strong>, em formato de aulas:</p>

    <div class="table-wrap">
      <table>
      <thead>
      <tr>
      <th>Opção</th>
      <th>Valor (lido em 17/11/2026)</th>
      <th>Prazo</th>
      <th>Acesso</th>
      </tr>
      </thead>
      <tbody>
      <tr>
      <td>Ingresso, 1º lote</td>
      <td>R$ 39</td>
      <td>Último dia do 1º lote em 17/11/2026</td>
      <td>2 dias ao vivo + certificado</td>
      </tr>
      <tr>
      <td>Gravação (adicional)</td>
      <td>R$ 199 ou até 12x de R$ 19,98</td>
      <td>Só até 04/12, às 23h59</td>
      <td>Liberada em até 7 dias depois do evento, vitalícia</td>
      </tr>
      </tbody>
      </table>
    </div>

    <p>A gravação é ideal para rever o conteúdo ao longo de 2027, e só é vendida junto com o ingresso, <strong>até 04/12/2026, às 23h59</strong>.</p>

    <div class="cta-wrap">
      <a class="btn-cta" href={go('valor')} target="_blank" rel="sponsored nofollow noopener">Garantir meu ingresso no lote atual</a>
    </div>

    <h2 id="izabella">Quem é a Izabella Camargo, que conduz a imersão?</h2>

    <p><strong>Izabella Camargo</strong> é jornalista, palestrante e uma das maiores referências em educação em saúde mental no trabalho do Brasil. É a criadora dos <strong>EPIs da Saúde Mental</strong> e do movimento pela <strong>Produtividade Sustentável</strong>.</p>

    <p>A trajetória dela tem reconhecimento público de peso:</p>

    <ul>
    <li><strong>LinkedIn Top Voice</strong>;</li>
    <li>palestrante <strong>TEDx cinco vezes</strong>;</li>
    <li>autora do best-seller <em><strong>Dá um Tempo!</strong></em>;</li>
    <li>reconhecida como Maior Influenciadora de RH do país no <strong>Prêmio iBest</strong> em 2023, 2024 e 2025;</li>
    <li><strong>Top of Mind RH 24/25</strong>.</li>
    </ul>

    <p>Há <strong>8 anos</strong> ela trabalha diretamente no universo corporativo, com palestras e letramentos para lideranças que já impactaram <strong>mais de 1 milhão de pessoas</strong> no Brasil, na França, nos EUA e na África.</p>

    <p>É essa experiência dentro das empresas que dá o tom da imersão: conteúdo pensado para quem precisa conversar com diretoria, RH e liderança. Na 5ª edição, ela conduz os dois dias ao lado de professores.</p>

    <h2 id="caminhos">Quais são os dois caminhos para 2027?</h2>

    <p>A imersão foi desenhada para dois caminhos profissionais, e você escolhe o seu:</p>

    <p><strong>Caminho 1: consultor externo.</strong> Você presta serviço para empresas que precisam se adequar à NR-1: mapeia os riscos, monta o programa e acompanha os resultados, no seu tempo e com a sua marca. Veja <a href="/blog/gestor-de-nr1-o-que-faz/">o que faz um Gestor de NR1</a>.</p>

    <p><strong>Caminho 2: dentro da empresa onde você já trabalha.</strong> Você se torna a referência em NR-1 na sua empresa, com voz nas decisões, reconhecimento da diretoria e caminho aberto para um novo cargo.</p>

    <p>Nos dois caminhos, a base é a mesma: aplicar a NR-1 na prática e saber se apresentar para quem decide. No exercício guiado, você escolhe o seu e sai com os próximos passos escritos.</p>

    <p>O momento ajuda. Numa pesquisa da Heach Recursos Humanos com 1.730 empresas brasileiras, divulgada pela Exame em janeiro de 2026 e citada pela página oficial, 68% afirmam não entender o que muda com a nova norma, 62% não têm indicador para acompanhar riscos psicossociais e 58% só agem quando o problema já explodiu. Veja também <a href="/por-que-se-tornar-gestor-de-nr1-agora/">por que se tornar Gestor de NR1 agora</a>.</p>

    <h2 id="formacao-especifica">Precisa de formação específica para atuar com NR-1?</h2>

    <p>A NR-1 e a NR-17 não estabelecem, de forma geral, um profissional específico ou uma categoria exclusiva para avaliar os riscos psicossociais. A própria página oficial da imersão cita o documento de perguntas e respostas do Ministério do Trabalho sobre o capítulo 1.5 da norma, pergunta 7:</p>

    <blockquote>
    <p>"A NR-1 e a NR-17 não estabelecem, de forma geral, um profissional específico ou categoria de profissional exclusiva (…). No entanto, a organização deve designar responsável ou equipe com conhecimento técnico adequado (…)."<br>
    MTE, Perguntas e Respostas sobre o Capítulo 1.5 da NR-1, pergunta 7.</p>
    </blockquote>

    <p>Ou seja: quem escolhe o responsável é a empresa, e o que se exige é <strong>conhecimento técnico adequado</strong>. É esse conhecimento que a imersão começa a construir com você, venha você da psicologia, do RH, da segurança do trabalho, da saúde ou de outra área.</p>

    <p>Para participar também não há pré-requisito acadêmico. Se você vem de outra área, leia <a href="/blog/como-atuar-com-nr1-sem-diploma/">como atuar com NR-1 sem diploma específico</a>.</p>

    <h2 id="para-quem">Para quem é a Imersão NR1 na Prática?</h2>

    <h3>Ideal para você se...</h3>

    <ul class="checks">
    <li>✔ trabalha (ou quer trabalhar) com empresas, pessoas, saúde ou segurança no trabalho;</li>
    <li>✔ é psicólogo, profissional de RH, de SST ou da saúde e quer levar a NR-1 para a prática;</li>
    <li>✔ quer começar 2027 como consultor de empresas, com cliente ideal, abordagem e proposta definidos;</li>
    <li>✔ quer ser a referência em NR-1 dentro da empresa onde trabalha e levar o tema à diretoria;</li>
    <li>✔ já estuda a norma, ou participou de outra edição, e quer atualizar tudo o que mudou em 2026;</li>
    <li>✔ tem mais de 40 ou 50 anos e quer usar a sua bagagem num campo novo para todo mundo.</li>
    </ul>

